<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
	<name>Muffalo-in-a-Box</name>

	<author>Tired Guy</author>

	<packageId>tiredguy.muffaloinabox</packageId> <!-- a unique identifier for the mod. Special characters are not allowed, at least one dot is required. This is what gets saved in a player's mod list, and having two identical IDs leads to the mod manager becoming incapable of loading the correct mod. The game internally stores these IDs using lower case characters only -->

	<description>Need a way to easily store mechanoids and animals when they aren't needed? Want to trade them over multiplayer mods to other players? This is the mod for you!</description>

	<supportedVersions>
		<li>1.5</li>
		<li>1.6</li>
	</supportedVersions>


	<modDependenciesByVersion>
		<v1.5>
			<li>
				<packageId>brrainz.harmony</packageId>
				<displayName>Harmony</displayName>
				<steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
			</li>
		</v1.5>
	</modDependenciesByVersion>

	<loadAfter>
  		<li>brrainz.harmony</li>
	</loadAfter>

	<!-- More information is available here: https://rimworldwiki.com/wiki/Modding_Tutorials/About.xml -->
</ModMetaData>
